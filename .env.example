# ---------------------------------------------------------------------------
# Powertek — contact endpoint configuration
#
# Copy this file to `.env` for local development (`.env` is git-ignored) and
# set the same variables in the Vercel dashboard for Preview + Production.
# Replace every placeholder below. Do NOT commit real values.
# ---------------------------------------------------------------------------

# --- Resend (email notification) -------------------------------------------

# API key from https://resend.com/api-keys — starts with "re_".
RESEND_API_KEY=re_your_resend_api_key_here

# The inbox that receives website enquiry notifications (your Gmail address).
# Comma-separate to notify more than one person.
CONTACT_TO_EMAIL=you@example.com

# The "From" address. The domain must be verified in Resend.
# Display name is optional: Powertek Website <enquiries@yourdomain.com>
CONTACT_FROM_EMAIL=Powertek Website <enquiries@yourdomain.com>


# --- Google Sheets (enquiry log) -------------------------------------------

# The long ID in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# The service account address, e.g. powertek-sheets@my-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The "private_key" value from the service account JSON key file.
# Keep the surrounding double quotes and the literal \n escape sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"


# --- Optional ---------------------------------------------------------------

# Name of the tab (worksheet) inside the spreadsheet. Defaults to "Sheet1".
# Required only if you rename the tab.
# GOOGLE_SHEET_TAB=Sheet1

# IANA timezone used to format the Timestamp column and the email footer.
# Defaults to Asia/Kolkata so the log reads in local Bengaluru time instead of
# UTC (Vercel functions run in UTC).
# CONTACT_TIMEZONE=Asia/Kolkata
